# Copy to ~/.config/aerc/accounts.conf, edit the address, and chmod 600.
# Store the Gmail app password with `pass insert mail/gmail-app`.
[gmail]
source = imaps://you%40gmail.com@imap.gmail.com:993
source-cred-cmd = pass mail/gmail-app
outgoing = smtps://you%40gmail.com@smtp.gmail.com:465
outgoing-cred-cmd = pass mail/gmail-app
from = Your Name <you@gmail.com>
default = INBOX
postpone = [Gmail]/Drafts
archive = [Gmail]/All Mail
